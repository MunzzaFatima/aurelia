# PostgreSQL connection string (create the DB first, see README)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aurelia?schema=public"
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Admin account created by the seed script (never through public sign-up)
ADMIN_EMAIL="admin@aurelia.example"
ADMIN_PASSWORD="ChangeMe!12345"
# Bank transfer details shown at checkout (set real ones before launch)
BANK_NAME="Your Bank"
BANK_ACCOUNT_TITLE="AURELIA"
BANK_IBAN="PK00XXXX0000000000000000"
